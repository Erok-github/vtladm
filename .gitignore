# Never commit or rsync build artifacts onto Linux — stale 0-byte vtladm breaks install.
/userspace/target/
/kernel/vtl.ko
/kernel/*.o
/kernel/**/*.o
/kernel/.*.cmd
/kernel/**/.*.cmd
/kernel/Module.symvers
/kernel/modules.order
/kernel/*.mod
/kernel/*.mod.c

# Editor / OS
*.swp
*~
.DS_Store
Thumbs.db

# Python caches from local test scripts
__pycache__/
*.pyc

# External files
*.rpm

# Field test scripts — local only, never commit
scripts/burst_verify.py
scripts/burst_writer.py
scripts/varrec_regress.py
scripts/vtl-full-stability-test.sh
scripts/vtl_realdata_test.sh
