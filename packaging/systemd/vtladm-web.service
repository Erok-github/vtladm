[Unit]
Description=VTL administration Web UI (vtladm serve)
Documentation=file:///opt/vtladm/docs/STACK.md
After=network.target vtl-kernel.service
Wants=vtl-kernel.service
ConditionPathExists=/opt/vtladm/bin/vtladm

[Service]
Type=simple
Environment=PATH=/sbin:/usr/sbin:/bin:/usr/bin
Environment=VTL_CONF_PATH=/opt/vtladm/var/vtl.conf
WorkingDirectory=/opt/vtladm/var
# Web bind vars come from /opt/vtladm/var/vtl.conf via vtladm-web-serve; do not use EnvironmentFile here.
ExecStart=/opt/vtladm/sbin/vtladm-web-serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
# Hardening note: ProtectSystem=strict + ReadWritePaths was tried here and
# abandoned — the bind-mount setup fails with status=226/NAMESPACE on
# hardened/fresh hosts (Kylin V10 SELinux enforcing, missing /etc/target
# before LIO is configured).  ProtectSystem=full keeps /usr /boot /efi
# read-only while leaving /opt /etc /sys writable — no mount namespace
# needed, same practical coverage for this service.
ProtectSystem=full

[Install]
WantedBy=multi-user.target
